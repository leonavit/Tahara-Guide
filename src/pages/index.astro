---
import GuideChatbot from "../components/chatbot/GuideChatbot";
import { PwaInstallButton } from "../components/pwa/PwaInstallButton";
import { SiteFooter } from "../components/site/SiteFooter";
import FamilyPurityApp from "../components/tracker/FamilyPurityApp";
import FamilyPuritySkeleton from "../components/tracker/FamilyPuritySkeleton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const baseHref = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const accessibilityHref = `${baseHref}accessibility/`;
---

<BaseLayout>
  <PwaInstallButton client:only="react" />
  <main class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 -z-10 h-[34rem] bg-soft-radial"></div>

    <div class="mx-auto flex min-h-screen max-w-7xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
      <FamilyPurityApp client:only="react">
        <FamilyPuritySkeleton slot="fallback" />
      </FamilyPurityApp>

      <SiteFooter accessibilityHref={accessibilityHref} client:only="react" />

      <GuideChatbot client:only="react" />
    </div>
  </main>
</BaseLayout>
